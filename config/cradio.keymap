#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Home row mods macro

#define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3  &ht RSHFT k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <220>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ltab {
            bindings = <&kp LS(TAB)>;
            key-positions = <17 16>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <17 18>;
            layers = <1 0 3 5>;
        };

        winLeft {
            bindings = <&kp LG(LEFT_ARROW)>;
            key-positions = <11 12>;
            layers = <0 1 3 2 5>;
        };

        winRight {
            bindings = <&kp LG(RIGHT_ARROW)>;
            key-positions = <12 13>;
        };

        pv {
            bindings = <&kp SEMI>;
            key-positions = <27 28>;
        };

        quotes {
            bindings = <&kp SQT>;
            key-positions = <18 19>;
        };

        to-nav {
            bindings = <&to 1>;
            key-positions = <16 17 18>;
            layers = <0>;
        };

        to-colemak {
            bindings = <&to 0>;
            key-positions = <16 17 18>;
            layers = <1>;
        };

        to-layers {
            bindings = <&to 5>;
            key-positions = <9 19 29>;
        };

        win-right {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <7 8>;
        };

        win-left {
            bindings = <&kp LG(LEFT_ARROW)>;
            key-positions = <7 6>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 11>;
        };

        all-windows {
            bindings = <&kp LA(TAB)>;
            key-positions = <13 12 11>;
        };

        defaultLayer {
            bindings = <&none>;
            key-positions = <0 10 20>;
        };

        winUp {
            bindings = <&kt LG(UP_ARROW)>;
            key-positions = <1 2 3>;
        };

        winDown {
            bindings = <&kp LG(DOWN_ARROW)>;
            key-positions = <21 22 23>;
        };
    };

    macros {
        pass: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp S &kp E &kp R &kp P &kp E &kp P &kp N3 &kp N &kp STAR>;
            label = "NEW_MACRO";
        };

        passVz: pass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp S &kp E &kp R &kp P &kp E &kp P &kp N3 &kp N &kp STAR &kp LS(V) &kp LS(T) &kp N2 &kp N5 &kp N0 &kp N8 &kp N0 &kp N4>;
            label = "PASS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESC Q       &mt LA(F4) W  &mt LC(F) F  &mt LG(RS(S)) P         &kp G                 &kp J       &kp L          &kp U      &mt LPAR Y  &kp LBKT
&mt LCTRL A     &lt 4 R       &lt 1 S      &lt 2 T                 &kp D                 &kp M       &kp N          &kp E      &kp I       &mt RSHFT O
&mt LEFT_ALT Z  &kp X         &kp C        &kp V                   &kp B                 &kp K       &kp H          &kp COMMA  &kp DOT     &kp FSLH
                                           &mt LEFT_CONTROL SPACE  &mt LEFT_GUI ENTER    &kp DELETE  &kp BACKSPACE
            >;
        };

        nav {
            bindings = <
&trans  &trans            &trans  &trans          &trans        &passVz                          &trans     &kp UP    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&trans  &kp LC(LEFT_ALT)  &trans  &kp LEFT_SHIFT  &trans        &kp HOME                         &kp LEFT   &kp DOWN  &kp RIGHT          &kp END
&trans  &trans            &trans  &trans          &trans        &trans                           &mkp LCLK  &passVz   &mkp RCLK          &trans
                                  &kp BACKSPACE   &kp DELETE    &mt LA(LS(LC(LEFT_GUI))) DELETE  &kp DEL
            >;
        };

        nums {
            bindings = <
&trans   &trans  &trans          &trans           &trans             &mt LBRC LBKT           &mt AMPERSAND NUMBER_7          &mt ASTERISK NUMBER_8  &mt LPAR NUMBER_9   &mt PLUS EQUAL
&none    &none   &kp LEFT_SHIFT  &none            &none              &mt RBRC RIGHT_BRACKET  &mt DLLR NUMBER_4               &mt PERCENT NUMBER_5   &mt CARET NUMBER_6  &mt ASTRK MINUS
&passVz  &trans  &trans          &trans           &trans             &none                   &mt EXCL NUMBER_1               &mt AT NUMBER_2        &mt HASH NUMBER_3   &mt PIPE BACKSLASH
                                 &mt LC(X) LC(C)  &mt LG(V) LC(V)    &trans                  &mt RIGHT_PARENTHESIS NUMBER_0
            >;
        };

        tri_layer {
            bindings = <
&sys_reset   &trans  &trans  &trans      &bt BT_SEL 0    &trans  &trans  &trans  &trans  &sys_reset
&bootloader  &trans  &kp B   &trans      &bt BT_SEL 1    &trans  &trans  &kp B   &trans  &bootloader
&trans       &trans  &trans  &bt BT_CLR  &bt BT_SEL 2    &trans  &trans  &trans  &trans  &trans
                             &trans      &trans          &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans          &mmv MOVE_UP    &trans           &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mmv MOVE_X(200)
&trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK       &trans          &mkp RCLK        &trans
                        &trans  &trans    &trans  &trans
            >;

            label = "mouse";
        };

        layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &to 3   &to 4   &to 5   &trans
&trans  &trans  &trans  &trans  &trans    &trans  &to 0   &to 1   &to 2   &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
